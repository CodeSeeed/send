# 复制为 .env 后按需修改(--env-file 实际使用 .env)。

# 对外端口(宿主机端口:容器 8081)
# SEND_PORT=8081

# 数据与上传目录的宿主机路径(相对 docker-compose.yml)或绝对路径
# SEND_DATA_DIR=./data
# SEND_UPLOADS_DIR=./uploads

# 上传大小上限(字节)。默认 30MB = 31457280
# SEND_MAX_SIZE=31457280

# 部署在受控反向代理后时,填代理 IP;公网直连请留空
# SEND_TRUSTED_PROXIES=127.0.0.1,::1

# 跨域来源(相对 compose 同源部署可留空)
# SEND_ALLOWED_ORIGINS=https://send.example.com